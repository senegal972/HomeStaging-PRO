# Copiez ce fichier en .env.local et remplissez vos clés
# Ne jamais committer le fichier .env.local sur GitHub

# === Clé API Gemini (Google AI Studio) ===
VITE_GEMINI_API_KEY=votre_cle_gemini_ici

# === Configuration Firebase ===
VITE_FIREBASE_API_KEY=votre_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=votre_projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre_projet_id
VITE_FIREBASE_STORAGE_BUCKET=votre_projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=votre_messaging_sender_id
VITE_FIREBASE_APP_ID=votre_app_id
